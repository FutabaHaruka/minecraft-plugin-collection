# CrownControl 1.0.0-rc8
# 严格存储目录：plugins/CrownControl/；目录名不匹配或所有权标记不匹配时插件拒绝启动。
# 仅拦截 Pixelmon 原生金色王冠与银色王冠，不配置/识别自定义皇冠。
# 插件不会主动修改个体值，也不会消耗、返还或检查任何物品/NBT；Pixelmon 自行执行极限训练并管理原生皇冠。
# 插件只管理：黑白名单、精灵类别、权限、金币、点券、概率、冷却与审计。
# 固定顺序：黑名单 -> 白名单 -> 精灵类别 -> 权限/冷却/货币预检 -> 概率 -> 原生放行/取消 -> 极限训练结果核验。
# 配置只写入 CrownControl 独占目录中的 config.yml；内置默认值使用唯一非 YAML 资源名。

settings:
  audit-log: true
  allow-eggs: false
  # 核验轮询间隔。银色王冠会先打开 Pixelmon 原生属性选择界面，因此不能只核验一次。
  native-verification-ticks: 2
  # 最长等待 600 tick（约 30 秒），用于等待银色王冠属性选择完成。
  native-verification-timeout-ticks: 600
  warn-fractional-probability: true

pokemon-lists:
  blacklist:
    - MissingNo
  whitelist: []
  op-bypasses-blacklist: true

rules:
  enabled: true
  cooldown-seconds: 30
  # SUCCESS / ATTEMPT / COST / ALWAYS / NEVER
  cooldown-on: SUCCESS
  allowed-categories:
    - normal
    - legendary
    - mythical
    - ultra-beast
  costs:
    money: 100000.0
    points: 10
  chance:
    success-rate: 35.0
    failure-rate: 65.0
    # ATTEMPT / SUCCESS / FAILURE / NEVER；仅控制插件管理的金币和点券。
    consume-on: ATTEMPT

categories:
  mythical:
    - Mew
    - Celebi
    - Jirachi
    - Deoxys
    - Phione
    - Manaphy
    - Darkrai
    - Shaymin
    - Arceus
    - Victini
    - Keldeo
    - Meloetta
    - Genesect
    - Diancie
    - Hoopa
    - Volcanion
    - Magearna
    - Marshadow
    - Zeraora
    - Meltan
    - Melmetal
    - Zarude
  ultra-beast:
    - Nihilego
    - Buzzwole
    - Pheromosa
    - Xurkitree
    - Celesteela
    - Kartana
    - Guzzlord
    - Poipole
    - Naganadel
    - Stakataka
    - Blacephalon
  legendary-fallback:
